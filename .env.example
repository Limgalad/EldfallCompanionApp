# Eldfall Companion Environment Variables

# Email to receive bug reports
BUG_REPORT_EMAIL=koendeurloo1987@gmail.com

# Secret used to sign bug-report CAPTCHA tokens. Set a long random value in
# production so tokens survive restarts; if unset, a random per-process secret
# is generated (tokens are then invalidated on every restart).
CAPTCHA_SECRET=

# SMTP Configuration for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
