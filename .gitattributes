# Normalize line endings: store text as LF in the repo, check out native.
# Prevents the mixed LF/CRLF state previously present across the rules/ files.
* text=auto eol=lf

# Markdown is text.
*.md text eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
